# Shared by EVERY design. On Netlify, set these once in
# Site configuration > Environment variables. Locally, copy this file to .env.

# Where /api/* calls from the previews go (the live website that runs the API
# routes and holds the server secrets). Defaults to NEXT_PUBLIC_APP_URL.
DESIGNER_API_ORIGIN=https://your-live-aicyro-site.com

# Public values that get built into every design.
NEXT_PUBLIC_APP_URL=https://your-live-aicyro-site.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Server secrets (OPENAI_API_KEY, EMAIL_PASS, AWS keys ...) are NOT needed here:
# they stay on the live site that answers /api/*.
